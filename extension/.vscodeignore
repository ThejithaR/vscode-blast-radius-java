# Source files
src/**
tsconfig.json
*.ts
!dist/**/*.ts

# Build artifacts  
*.map

# Documentation
IMPLEMENTATION_GUIDE.md
md/**

# Examples — kept in the vsix for fallback when real components aren't built.
# Sources stay excluded; only the JSON fixtures ship.
# (examples/**/*.json is included implicitly by NOT being excluded.)
examples/**/*.md

# Development files
.gitignore
.vscode/**
.editorconfig
tsconfig.tsbuildinfo

# Test files
test/**
**/*.test.ts
**/*.spec.ts

# Misc
.DS_Store
*.log
npm-debug.log*

# Exclude all node_modules
node_modules/**

# Exclude parent directory
../**

