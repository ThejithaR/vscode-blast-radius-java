{
  "name": "blast-radius-mapper",
  "displayName": "Blast Radius Mapper",
  "description": "Maps the semantic blast radius of Java code changes using JavaParser + IBM Bob.",
  "version": "0.0.1",
  "publisher": "blast-radius",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ThejithaR/vscode-blast-radius-java.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:blastRadius.map"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blastRadius.map",
        "title": "Blast Radius: Map",
        "category": "Blast Radius"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@blast-radius/ai-orchestrator": "*",
    "@blast-radius/git-engine": "*",
    "@blast-radius/shared": "*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "open": "^11.0.0",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.3.0"
  }
}
