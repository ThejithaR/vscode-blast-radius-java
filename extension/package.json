{
  "name": "@blast-radius/extension",
  "displayName": "Blast Radius Mapper",
  "description": "Maps the semantic blast radius of Java code changes using JavaParser + IBM Bob.",
  "version": "0.0.1",
  "publisher": "blast-radius",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCommand:blastRadius.map"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blastRadius.map",
        "title": "Blast Radius: Map",
        "category": "Blast Radius"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "watch": "tsc -p ./tsconfig.json --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "dependencies": {
    "@blast-radius/shared": "*",
    "@blast-radius/git-engine": "*",
    "@blast-radius/ai-orchestrator": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
