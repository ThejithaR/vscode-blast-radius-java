{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blast-radius/ast-dependencies-output.schema.json",
  "title": "AstDependenciesOutput",
  "description": "Output of ast-engine (Member 3). Contains ONLY the downstream dependency list. Merged with GitDeltaOutput by extension orchestrator (M1) to form Contract A.",
  "type": "object",
  "required": ["dependencies"],
  "additionalProperties": false,
  "properties": {
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filePath", "packageName", "importedSymbols", "callSites"],
        "additionalProperties": false,
        "properties": {
          "filePath": {
            "type": "string",
            "description": "Workspace-relative path of the caller file."
          },
          "packageName": {
            "type": "string",
            "description": "Fully-qualified Java package of the caller."
          },
          "importedSymbols": {
            "type": "array",
            "items": { "type": "string" }
          },
          "callSites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["callerMethod", "lineNumber", "usageContextLine"],
              "additionalProperties": false,
              "properties": {
                "callerMethod": {
                  "type": "string",
                  "description": "The method or constructor containing this call site."
                },
                "lineNumber": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "1-based line number of the call expression."
                },
                "usageContextLine": {
                  "type": "string",
                  "description": "The exact source line where the changed method is called."
                }
              }
            }
          }
        }
      }
    }
  }
}
